    },
    {
      "uri": "tuic://11111111-1111-4111-8111-111111111111@example.net:443?password=secret&congestion-controller=cubic&udp-relay-mode=quic&alpn=custom",
      "expected": {
        "type": "tuic",
        "server": "example.net",
        "port": 443,
        "uuid": "11111111-1111-4111-8111-111111111111",
        "password": "secret",
        "alpn": [
          "custom"
        ],
