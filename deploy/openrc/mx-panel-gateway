#!/sbin/openrc-run
name="Mx-Panel HTTPS gateway"
description="Mx-Panel HTTPS access and certificates"
supervisor="supervise-daemon"
command="/opt/mx-panel-openrc/current/mxioc"
command_args="--gateway /etc/mx-panel-openrc/access.json"
# Root is required for ports 80/443 on standard OpenRC hosts.
output_log="/var/log/mx-panel/gateway.log"
error_log="/var/log/mx-panel/gateway.log"
respawn_delay=3
respawn_max=5
respawn_period=60
retry="TERM/15/KILL/5"
umask=0077
depend() { need net mx-panel; }
start_pre() {
    checkpath -d -m 0750 /var/log/mx-panel
    checkpath -f -m 0600 "$output_log"
    "$command" --check-access /etc/mx-panel-openrc/access.json
}
