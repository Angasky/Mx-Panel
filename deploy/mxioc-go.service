[Unit]
Description=Mxioc native Go migration service
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/mxioc-rule-manager
ExecStartPre=/opt/mxioc-rule-manager/mxioc --root /opt/mxioc-rule-manager --auth /etc/mxioc-rule-manager.auth.json --check-data
ExecStart=/opt/mxioc-rule-manager/mxioc --root /opt/mxioc-rule-manager --auth /etc/mxioc-rule-manager.auth.json --listen 127.0.0.1:62578 --trust-loopback-proxy
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
