# Independent subscription hostname. Configure DNS and issue this certificate
# before enabling this server block. Do not replace the management vhost.
server {
    listen 443 ssl;
    server_name sub.example.com;

    ssl_certificate /etc/letsencrypt/live/sub.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sub.example.com/privkey.pem;

    # Public monitoring stays on the management hostname.
    location ~ ^/sub/status(?:/|-(?:public|api|series|ws)$) { return 404; }

    # Public subscription routes only; no management/API/Agent endpoints.
    location ~ ^/(sub/[^/]+|convert/[^/]+/[^/]+)$ {
        limit_except GET HEAD { deny all; }
        # Keep large UI/subscription responses off shared proxy temp directories.
        proxy_max_temp_file_size 0;
        proxy_pass http://127.0.0.1:62578;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_cache off;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    location / { return 404; }
}
